<% outdated = @languages.any? { |l| @data[l.id][:translations][unit.id]&.outdated? } %>
<div id="<%= dom_id(unit) %>" class="rounded border bg-white <%= outdated ? 'border-amber-300' : 'border-stone-200' %>">
  <div class="border-b border-stone-100 px-3 py-1.5 text-xs">
    <span class="mr-1 text-stone-400 tabular-nums">#<%= @indexes[unit.id] %></span>
    <span class="font-mono text-stone-500"><%= unit.key %></span>
  </div>
  <% if unit.note %>
    <p class="border-b border-sky-100 bg-sky-50 px-3 py-1 font-mono text-xs whitespace-pre-wrap text-sky-800"># <%= unit.note %></p>
  <% end %>
  <%# Each column is a 3-row subgrid (header, box, extras) : the source box and the textareas share one height %>
  <div class="grid grid-cols-1 gap-x-3 gap-y-1 p-3 <%= @languages.size > 1 ? 'md:grid-cols-3' : 'md:grid-cols-2' %>">
    <%# Main reference : the fr source, or the en translation when the user chose it (fr stays the official source) %>
    <% en = @references[unit.id] %>
    <% en_main = @en_reference && en.present? %>
    <div class="row-span-3 grid min-w-0 grid-rows-subgrid text-sm">
      <div class="flex h-5 items-center gap-2 text-xs font-medium text-stone-700">
        <% if en_main %>
          <span>en · <%= t(".reference") %></span>
          <% if en.outdated? %><span class="rounded bg-amber-100 px-1.5 font-normal text-amber-800"><%= t(".en_outdated") %></span><% end %>
        <% else %>
          <span><%= Language::SOURCE_CODE %> · <%= t(".source") %></span>
          <% if @en_reference %><span class="rounded bg-stone-100 px-1.5 font-normal text-stone-600"><%= t(".en_missing") %></span><% end %>
        <% end %>
      </div>
      <% reference = en_main ? en.text : unit.source_text %>
      <div class="rounded border px-2 py-1.5 font-mono whitespace-pre-wrap <%= en_main && en.outdated? ? 'border-amber-200 bg-amber-50' : 'border-stone-200 bg-stone-50' %>"
           data-controller="i18n-text" data-i18n-text-text-value="<%= reference %>" data-i18n-text-refs-value="<%= @ref_texts[unit.id].to_json %>"><%= reference %></div>
      <div class="pb-3 md:pb-0">
        <% if en_main %>
          <p class="mt-2 whitespace-pre-wrap text-xs <%= en.outdated? ? 'text-stone-800' : 'text-stone-500' %>"><span class="font-medium"><%= Language::SOURCE_CODE %> · <%= t(".source") %></span> · <%= unit.source_text %></p>
        <% end %>
        <% if (previous = @previous_sources[unit.id]) && outdated %>
          <p class="mt-1 whitespace-pre-wrap text-xs text-stone-500"><%= "#{Language::SOURCE_CODE} " if en_main %><%= t(".before") %> <del><%= previous %></del></p>
        <% end %>
        <% if en && !en_main %>
          <p class="mt-2 whitespace-pre-wrap text-xs text-stone-500"><span class="font-medium">en</span> · <%= en.text %></p>
        <% end %>
      </div>
    </div>
    <% @languages.each do |language| %>
      <%= render "editor", unit: unit, language: language, data: @data[language.id] %>
    <% end %>
    <%# Comments : auto-placed on the next row, each under its language's column %>
    <div class="mt-2 hidden border-t border-stone-100 md:block"></div>
    <% @languages.each do |language| %>
      <% data = @data[language.id] %>
      <details class="mt-2 min-w-0 border-t border-stone-100 pt-1 text-xs">
        <summary class="cursor-pointer <%= data[:open_questions].include?(unit.id) ? 'font-medium text-sky-700' : 'text-stone-500' %>">
          💬 <%= "#{language.name} · " if @languages.size > 1 %><%= t(".comments", count: data[:comment_counts][unit.id] || 0) %><%= " · #{t('.open_question')}" if data[:open_questions].include?(unit.id) %>
        </summary>
        <div class="py-2">
          <%= turbo_frame_tag "comments_#{unit.id}_#{language.code}", src: unit_comments_path(unit, lang: language.code), loading: :lazy do %>
            <span class="text-stone-400"><%= t("loading") %></span>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>
</div>

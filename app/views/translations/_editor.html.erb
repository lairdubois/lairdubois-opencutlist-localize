<% t = data[:translations][unit.id] %>
<% warnings = t ? TranslationChecks.call(unit.source_text, t.text, glossary: data[:glossary], language: language) : [] %>
<% fill = "const a = this.closest('turbo-frame').querySelector('textarea'); a.value = this.dataset.text; a.dispatchEvent(new Event('input'))" %>
<%# Spans the row's 2 subgrid rows (box, extras) so its box shares the height of its neighbours. unit_page : an admin's
    correction on the key's page (UnitTranslationsController : the text saved alone, no comments nor history buttons) %>
<%# group : the frame's parts follow the form's unsaved state (dirty-form) %>
<% unit_page = local_assigns[:unit_page] %>
<%= turbo_frame_tag dom_id(unit, language.code), class: "group row-span-2 grid min-w-0 grid-rows-subgrid" do %>
  <%# Copied as is into every language (Unit::COPIED_SOURCE) : read-only, what the export writes %>
  <% if unit.copied %>
    <div class="flex min-w-0 flex-col border-y border-stone-200 bg-stone-50 md:border-l">
      <p class="flex-1 px-3 py-2 font-mono text-sm whitespace-pre-wrap text-stone-500" dir="ltr"><%= highlight_search(unit.source_text) %></p>
      <%# Under a dashed line, as the editor's warnings, in a neutral tone (an information) %>
      <div class="flex flex-col gap-1 border-t border-dashed border-stone-200 px-3 py-1.5">
        <p class="flex items-start gap-1 text-xs text-stone-500">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-px h-3.5 w-3.5 shrink-0" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
          </svg>
          <%= t("status.copied_hint") %>
        </p>
      </div>
    </div>
    <div class="flex items-center justify-end gap-2 px-3 py-1.5">
      <%= render "translations/comments_button", unit: unit, language: language, count: data[:comment_counts][unit.id] || 0,
                                    questions: data[:open_questions][unit.id] || 0, admin_notes: data[:open_admin_notes][unit.id] || 0 %>
    </div>
  <%# A reader (Membership reader) : the stored text, read-only, its warnings, the issues and comments (a reader comments).
      A click in the box tells them so (read-only controller) %>
  <% elsif !unit_page && !current_user.can_translate?(language) %>
    <div class="flex min-w-0 flex-col border-y border-stone-200 md:border-l <%= t.nil? ? 'bg-yellow-50' : t.to_review? ? 'bg-orange-50' : 'bg-white' %>"
         data-controller="read-only" data-read-only-message-value="<%= t("translations.index.read_only_hint") %>"
         data-action="click->read-only#show">
      <% if t %>
        <div class="flex-1 px-3 py-2 font-mono text-sm whitespace-pre-wrap" dir="<%= language.rtl ? 'rtl' : 'ltr' %>" lang="<%= language.code %>"
             data-controller="i18n-text" data-i18n-text-text-value="<%= t.text %>" data-i18n-text-source-value="<%= unit.source_text %>"
             data-i18n-text-refs-value="<%= refs_json(@refs[unit.id]) %>"><%= t.text %></div>
      <% else %>
        <p class="flex-1 px-3 py-2 text-sm text-stone-400 italic"><%= t("status.not_translated").capitalize %></p>
      <% end %>
      <% if warnings.any? %>
        <div class="flex flex-col gap-1 border-t border-dashed border-stone-200 px-3 py-1.5">
          <% warnings.each do |w| %><p class="text-xs text-amber-700">⚠ <%= w %></p><% end %>
        </div>
      <% end %>
    </div>
    <div class="flex items-center gap-2 px-3 py-1.5">
      <%= render "translations/issues_button", unit: unit, language: language, count: data[:issues][unit.id] || 0 %>
      <%= render "translations/comments_button", unit: unit, language: language, count: data[:comment_counts][unit.id] || 0,
                                    questions: data[:open_questions][unit.id] || 0, admin_notes: data[:open_admin_notes][unit.id] || 0 %>
    </div>
  <% else %>
  <%# hidden : the streams stay out of the frame's grid until Turbo performs and drops them %>
  <% if local_assigns[:saved] %>
    <div hidden>
      <%= turbo_stream.replace "status_#{unit.id}_#{language.code}", partial: "translations/status", locals: { unit: unit, language: language, translation: t } %>
      <%# A save adds a revision : the history panel reloads (now if shown, else when it is) %>
      <% if current_user.admin? %>
        <%= turbo_stream.replace "history_#{unit.id}_#{language.code}", partial: "translations/history_frame", locals: { unit: unit, language: language } %>
      <% end %>
    </div>
  <% end %>
  <%# i18n-text swaps the textarea for a CodeMirror editor (source invariants locked), keeping it in sync for the form %>
  <%= form_with url: unit_page ? unit_translation_path(unit, language.code) : translate_unit_path(language.code, unit), method: :patch,
                class: "contents",
                data: { controller: "i18n-text dirty-form", i18n_text_source_value: unit.source_text, i18n_text_refs_value: refs_json(@refs[unit.id]) } do %>
    <%# The box : the editor, then the proposals under it, so they grow the row (the source box beside follows).
        Its background, the translation's status (or unsaved), runs under both %>
    <div class="flex min-w-0 flex-col border-stone-200 <%= unit_page ? 'border-t md:border-t-0 md:border-l' : 'border-y md:border-l' %> <%= t.nil? ? 'bg-yellow-50' : t.to_review? ? 'bg-orange-50' : 'bg-white' %> group-has-data-dirty:bg-sky-50">
      <%= text_area_tag :text, t&.text, rows: 1, dir: language.rtl ? "rtl" : "ltr", lang: language.code,
                        data: { i18n_text_target: "field" },
                        class: "block w-full flex-1 resize-none overflow-hidden px-3 py-2 font-mono text-sm bg-transparent" %>
      <% machine = data[:machine][unit.id] if t.nil? || t.outdated? %>
      <% suggestions = data[:suggestions][unit.source_text] if t.nil? %>
      <%# One section per kind, each under a dashed line. Hidden while empty : the chips come and go with the text (i18n-text) %>
      <div class="flex flex-col not-has-[>:not([hidden])]:hidden *:border-t *:border-dashed *:border-stone-200 *:px-3 *:py-1.5">
        <div class="flex flex-wrap gap-1" data-i18n-text-target="chips" hidden></div>
        <% if warnings.any? %>
          <div class="flex flex-col gap-1">
            <% warnings.each do |w| %><p class="text-xs text-amber-700">⚠ <%= w %></p><% end %>
          </div>
        <% end %>
        <%# Two columns : the label on the left, the proposals beside it, wrapping in their own column %>
        <% if machine %>
          <div class="grid grid-cols-[auto_minmax(0,1fr)] items-start gap-x-2 text-xs text-stone-500">
            <span class="whitespace-nowrap"><%= robot_icon %> <%= t(".machine") %></span>
            <button type="button" class="justify-self-start whitespace-pre-wrap rounded bg-violet-50 px-1.5 text-left text-violet-900 hover:bg-violet-100"
                    onclick="<%= fill %>" data-text="<%= machine %>"><%= machine %></button>
          </div>
        <% end %>
        <% if suggestions.present? %>
          <div class="grid grid-cols-[auto_minmax(0,1fr)] items-start gap-x-2 text-xs text-stone-500">
            <span class="whitespace-nowrap"><%= t(".same_text") %></span>
            <div class="flex flex-wrap gap-1">
              <% suggestions.each do |s| %>
                <button type="button" class="whitespace-pre-wrap rounded bg-sky-50 px-1.5 text-left text-sky-800 hover:bg-sky-100"
                        onclick="<%= fill %>" data-text="<%= s %>"><%= s %></button>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <%# The key's page : the bar (its top line) hidden while it shows nothing (no issue nor saved mark, clean, nothing to approve) %>
    <% bar = if !unit_page then ""
             elsif data[:issues][unit.id] || local_assigns[:saved] then "border-t border-stone-200 md:border-l"
             else "hidden border-t border-stone-200 md:border-l group-has-data-dirty:flex has-[[type=submit]:enabled:not([hidden])]:flex"
             end %>
    <div class="flex flex-col gap-1 px-3 py-1.5 <%= bar %>">
      <div class="flex items-center justify-end gap-2">
        <%# Issues, comments, history : on the left, pushing the rest right. The key's page has its own comments and history %>
        <div class="mr-auto flex min-w-0 items-center gap-2">
          <%# Open issues of the key (a consistency review's points) %>
          <%= render "translations/issues_button", unit: unit, language: language, count: data[:issues][unit.id] || 0 %>
          <% unless unit_page %>
          <%= render "translations/comments_button", unit: unit, language: language, count: data[:comment_counts][unit.id] || 0,
                                        questions: data[:open_questions][unit.id] || 0, admin_notes: data[:open_admin_notes][unit.id] || 0 %>
          <% if current_user.admin? %>
            <button type="button" data-disclosure-target="button" data-action="disclosure#toggle" data-disclosure-panel-param="history"
                    class="group/history flex items-center gap-1 rounded px-1 text-xs text-stone-400 hover:bg-stone-100 aria-expanded:bg-stone-100">
              <%= chevron_icon("group-aria-expanded/history:rotate-90") %>
              <%= t(".history") %>
            </button>
          <% end %>
          <% end %>
        </div>
        <span class="hidden text-xs text-sky-700 group-has-data-dirty:inline">● <%= t("unsaved.marker") %></span>
        <% if local_assigns[:saved] %><span class="text-xs text-emerald-700 group-has-data-dirty:hidden">✓ <%= t(".saved") %></span><% end %>
        <%# The key's page : the saved text back (the editor reloaded), left of the save, while there are edits %>
        <% if unit_page %>
          <%= link_to t(".cancel"), unit_edit_translation_path(unit, language.code),
                      class: "hidden rounded border border-stone-300 bg-white px-2 py-0.5 text-xs text-stone-600 group-has-data-dirty:inline-block hover:border-stone-400 hover:text-stone-900" %>
        <% end %>
        <%# Saving an outdated translation unchanged revalidates it against the current fr : always allowed.
            Otherwise disabled, and hidden, while the form is clean (dirty-form). The key's page saves the text alone
            (status kept) : nothing to save while clean %>
        <% clean_save = unit_page || !t&.outdated? %>
        <%= submit_tag t(".save"), title: t("unsaved.save_shortcut"), disabled: clean_save, data: { dirty_form_target: ("submit" if clean_save) },
                       class: "rounded border border-stone-800 bg-stone-800 px-2 py-0.5 text-xs text-white disabled:hidden" %>
        <%# The key's page keeps the status on save : nothing to approve on an approved, up to date translation, even edited %>
        <% unless unit_page && t&.approved? && !t.outdated? %>
          <%= render "translations/review_button", unit: unit, language: language, translation: t, contested: data[:contested].include?(unit.id) %>
        <% end %>
      </div>
    </div>
  <% end %>
  <% end %>
<% end %>

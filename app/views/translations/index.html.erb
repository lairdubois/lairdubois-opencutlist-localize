<% content_for :title, "#{@language.name} · OpenCutList Localize" %>
<%# reference : the ref-en class shows the en reference instead of the fr source in the rows, switched without a reload %>
<div data-controller="reference" data-reference-url-value="<%= reference_language_path %>"
     class="<%= 'ref-en' if @en_reference %>">
<%# Toolbar (filters, search, column headers) stays on screen above the rows, under the sticky site header.
    z-10 : the rows' editors hold positioned spans (whitespace marks) that would otherwise paint over it. %>
<div class="sticky top-[calc(3.5rem+1px)] z-10 -mx-4 -mt-3 mb-2 border-b border-stone-200 bg-stone-50 px-4 pt-3">
  <div class="mb-2 flex flex-wrap items-start gap-3">
    <h1 class="py-1 text-lg font-semibold"><%= t("layouts.application.translate") %></h1>
    <%= render "shared/search_bar", url: translate_path(@language.code), hidden: {}, counts: @counts, users: @users, count: @count,
                                     sorts: ListFilters::SORTS.keys %>
  </div>

  <% todo = @units.select { |u| (t = @data[:translations][u.id]).nil? || t.outdated? } %>
  <div class="flex flex-wrap items-center gap-2 text-sm has-[>:not([hidden])]:mb-2">
    <% if Pretranslator.enabled? && todo.any? %>
      <%= button_to t(".pretranslate", language: @language.name, count: todo.size), pretranslate_path(@language.code),
                    params: { unit_ids: todo.map(&:id) }, class: "rounded border border-violet-300 bg-violet-50 px-2 py-0.5 text-violet-900" %>
    <% end %>
  </div>

  <%# Column headers, on the rows' grid : reference choice over the source, the language over its editor.
      The grid keeps the rows' 1px border ; the language's name sits over the editor's text (its 1px border + px-3),
      the outer controls on the toolbar's edges. %>
  <div class="mb-2 grid grid-cols-1 items-center gap-y-2 border border-transparent md:grid-cols-2">
    <div class="-ml-px flex items-center gap-1 text-xs text-stone-500">
      <% if @en %>
        <%= t(".reference") %>
        <% User::REFERENCE_LANGUAGES.each do |code| %>
          <button type="button" data-reference-target="button" data-action="reference#choose" data-reference-code-param="<%= code %>"
                  aria-pressed="<%= code == current_user.reference_language %>"
                  class="rounded px-1.5 py-0.5 text-stone-500 hover:bg-stone-200 aria-pressed:bg-stone-800 aria-pressed:text-white"><%= code.upcase %></button>
        <% end %>
      <% end %>
    </div>
    <div class="-mr-px flex min-w-0 items-center justify-between gap-3 md:pl-[13px]">
      <%# unsaved-guard counts the unsaved edits here ; a click scrolls to the first one %>
      <div class="flex min-w-0 items-center gap-2">
        <h2 class="text-lg font-semibold"><%= @language.name %></h2>
        <button type="button" hidden data-unsaved-guard-target="count" data-action="unsaved-guard#reveal"
                class="rounded bg-sky-50 px-2 py-0.5 text-sm text-sky-800 hover:bg-sky-100"></button>
      </div>
      <div class="flex items-center gap-1">
        <button type="button" data-controller="html-toggle" data-action="html-toggle#toggle"
                data-html-toggle-class-value="hide-keys" data-html-toggle-key-value="ocl-localize.show-keys" data-html-toggle-inverse-value="true"
                title="<%= t(".show_keys") %>" aria-label="<%= t(".show_keys") %>"
                class="flex h-5 w-5 items-center justify-center rounded text-stone-500 hover:bg-stone-200 aria-pressed:bg-stone-800 aria-pressed:text-white">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-3.5 w-3.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
          </svg>
        </button>
        <button type="button" data-controller="html-toggle" data-action="html-toggle#toggle"
                data-html-toggle-class-value="show-ws" data-html-toggle-key-value="ocl-localize.show-whitespace" title="<%= t(".show_whitespace") %>"
                class="flex h-5 w-5 items-center justify-center rounded font-mono text-xs text-stone-500 hover:bg-stone-200 aria-pressed:bg-stone-800 aria-pressed:text-white">¶</button>
      </div>
    </div>
  </div>
</div>

<div class="flex flex-col gap-3">
  <%= render "page" %>
</div>
</div>
<% if @units.empty? %>
  <%= render "shared/empty_list", counts: @counts,
             unfiltered_url: translate_path(@language.code, list_params.except(:status, :questions, :warnings)) %>
<% end %>

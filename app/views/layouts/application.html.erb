<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "OpenCutList Localize" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# unsaved-guard : asks before leaving a page with unsaved forms (dirty-form) %>
  <body class="bg-stone-50 text-stone-900" data-controller="unsaved-guard tooltip"
        data-unsaved-guard-message-value="<%= t("unsaved.confirm") %>" data-unsaved-guard-labels-value="<%= t("unsaved.count").to_json %>">
    <%# Sticky : 3.5rem nav + 1px border, page toolbars stick below it (.toolbar in application.css) %>
    <header class="sticky top-0 z-20 border-b border-stone-200 bg-white">
      <nav class="mx-auto max-w-6xl px-4 h-14 flex items-center gap-6 text-sm">
        <%= link_to root_path, class: "flex items-center gap-2 text-base font-semibold" do %>
          <img src="/icon.svg" alt="" class="size-7">
          OpenCutList Localize
        <% end %>
        <% if current_user %>
          <% if current_user.admin? %>
            <%= nav_link :keys, units_path %>
          <% end %>
          <%= nav_link :translate, translate_root_path %>
          <%= nav_link :glossary, glossary_path %>
          <% if current_user.readable_languages.exists? %>
            <%= nav_link :export, exports_path %>
          <% end %>
          <% if current_user.admin? %>
            <%# The admin sections in a dropdown (native popover, like the user menu) : the button is underlined
                when the current page is one of them, and carries the pending volunteers' badge %>
            <% volunteers = VolunteerRequest.pending.count %>
            <% volunteers_title = t(".volunteers_pending", count: volunteers) if volunteers.positive? %>
            <% admin_active = ApplicationHelper::ADMIN_MENU.any? { |s| nav_section?(s) } %>
            <div data-controller="popover" data-popover-align-value="left" class="flex h-full">
              <button type="button" popovertarget="admin-menu" data-popover-target="anchor" title="<%= volunteers_title %>"
                      class="flex h-full items-center gap-1.5 border-b-2 pt-0.5 <%= admin_active ? "border-stone-800 font-medium text-stone-900" : "border-transparent text-stone-600 hover:text-stone-900" %>">
                <%= t(".admin") %> <%= nav_badge(volunteers) %> <span class="text-xs text-stone-400">▾</span>
              </button>
              <div id="admin-menu" popover data-popover-target="panel" data-action="beforetoggle->popover#place"
                   class="m-0 min-w-48 rounded border border-stone-200 bg-white p-1 text-sm shadow-lg">
                <%= admin_menu_link :sync, new_sync_path %>
                <%= admin_menu_link :import, new_import_path %>
                <%= admin_menu_link :pretranslations, pretranslations_path %>
                <%= admin_menu_link :languages, manage_languages_path %>
                <%= admin_menu_link :users, users_path, badge: volunteers, title: volunteers_title %>
                <%= admin_menu_link :publish, publications_path %>
              </div>
            </div>
          <% end %>
          <%# Help : the guide and the form to the admins, told where the user was (from) ; the admins' badge counts the open requests %>
          <% help_open = HelpRequest.unresolved.count if current_user.admin? %>
          <div class="ml-auto flex h-full">
            <%= nav_link :help, help_path(from: (request.fullpath unless nav_section?(:help))),
                         badge: help_open, title: (t(".help_open", count: help_open) if help_open.to_i.positive?) %>
          </div>
          <span class="flex gap-1 text-xs">
            <% I18n.available_locales.each do |locale| %>
              <%= button_to locale.upcase, locale_path, method: :patch, params: { locale: locale },
                            class: "rounded px-1.5 py-0.5 #{locale == I18n.locale ? 'bg-stone-800 text-white' : 'text-stone-500 hover:bg-stone-200'}" %>
            <% end %>
          </span>
          <%# User menu : native popover (light dismiss, Esc), placed under its button by popover_controller %>
          <div data-controller="popover">
            <button type="button" popovertarget="user-menu" data-popover-target="anchor"
                    class="flex items-center gap-1 rounded px-2 py-1 text-stone-600 hover:bg-stone-100 hover:text-stone-900">
              <%= current_user.name %> <span class="text-xs text-stone-400">▾</span>
            </button>
            <div id="user-menu" popover data-popover-target="panel" data-action="beforetoggle->popover#place"
                 class="m-0 min-w-48 rounded border border-stone-200 bg-white p-1 text-sm shadow-lg">
              <p class="truncate px-3 py-1.5 text-xs text-stone-500"><%= current_user.email %></p>
              <%= button_to t(".logout"), session_path, method: :delete,
                            class: "w-full rounded px-3 py-1.5 text-left text-stone-700 hover:bg-stone-100" %>
            </div>
          </div>
        <% end %>
      </nav>
    </header>
    <%# Flash messages as toasts, centered under the sticky header (h-14 + 1px border) : a notice leaves after a while, an alert stays until closed.
        data-turbo-temporary : dropped before Turbo caches the page, so going back doesn't replay them %>
    <% if notice || alert %>
      <div class="pointer-events-none fixed top-[calc(4rem+1px)] left-1/2 z-30 flex w-96 max-w-[calc(100vw-2rem)] -translate-x-1/2 flex-col gap-2" data-turbo-temporary>
        <% { notice: notice, alert: alert }.compact_blank.each do |kind, message| %>
          <div role="<%= kind == :alert ? "alert" : "status" %>" data-controller="toast" data-toast-delay-value="<%= kind == :alert ? 0 : 5000 %>"
               data-toast-hidden-class="-translate-y-4 opacity-0" data-action="mouseenter->toast#pause mouseleave->toast#resume"
               class="pointer-events-auto flex -translate-y-4 items-start gap-2 rounded border px-3 py-2 text-sm opacity-0 shadow-lg transition duration-200
                      <%= kind == :alert ? "border-red-200 bg-red-50 text-red-800" : "border-emerald-200 bg-emerald-50 text-emerald-800" %>">
            <p class="min-w-0 flex-1 break-words"><%= message %></p>
            <button type="button" data-action="toast#dismiss" aria-label="<%= t(".close") %>" title="<%= t(".close") %>"
                    class="-mr-1 shrink-0 rounded px-1 leading-5 opacity-60 hover:opacity-100">×</button>
          </div>
        <% end %>
      </div>
    <% end %>
    <main class="mx-auto max-w-6xl px-4 py-6">
      <% if current_user&.admin? && Setting["repo_fr_changed_at"].present? %>
        <p class="mb-4 rounded bg-sky-50 px-3 py-2 text-sky-900"><%= t(".repo_changed") %> <%= link_to t(".sync_now"), new_sync_path, class: "underline" %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>

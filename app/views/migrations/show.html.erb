<h1 class="mb-4 text-lg font-semibold"><%= t(".title") %></h1>

<section class="mb-6 rounded border border-stone-200 bg-white p-4 text-sm">
  <h2 class="mb-2 font-semibold"><%= t(".connection") %></h2>
  <% if @configured %>
    <p><%= t(".resource") %> <code>o:<%= @config.organization %>:p:<%= @config.project %>:r:<%= @config.resource %></code>
      <% if @config.language_map.any? %>· <%= t(".language_map") %> <code><%= @config.language_map.map { |k, v| "#{k}=#{v}" }.join(", ") %></code><% end %></p>
    <div class="mt-3 flex gap-2">
      <%= button_to t(".analyze"), migration_analyze_path, class: "rounded bg-stone-800 px-3 py-1.5 text-white",
                    form: { data: { turbo: false } } %>
      <%= link_to t(".invite"), migration_roster_path, class: "rounded border border-stone-300 px-3 py-1.5" %>
    </div>
  <% else %>
    <p class="text-stone-600"><%= t(".not_configured_html") %></p>
  <% end %>
</section>

<section class="rounded border border-stone-200 bg-white p-4 text-sm">
  <h2 class="mb-2 font-semibold"><%= t(".switch") %></h2>
  <ol class="list-decimal space-y-1 pl-5">
    <li><%= t(".step1") %></li>
    <li><%= t(".step2_html") %></li>
    <li><%= t(".step3") %> <span class="text-stone-500"><%= t(".invited", count: @invited.size) %></span></li>
    <li><%= t(".step4_html") %></li>
    <li><%= t(".step5") %></li>
  </ol>
</section>

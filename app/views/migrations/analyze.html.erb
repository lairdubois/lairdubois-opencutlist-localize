<h1 class="mb-4 text-lg font-semibold"><%= t(".title") %> <span class="text-sm font-normal text-stone-500">: <%= t(".dry_run") %></span></h1>
<div class="mb-6 overflow-x-auto rounded border border-stone-200 bg-white text-sm">
  <table class="w-full">
    <thead class="border-b border-stone-200 text-left text-xs text-stone-500">
      <tr><th class="px-3 py-2"><%= t(".columns.language") %></th>
        <% %w[found matched updates reviews conflicts unmatched translators].each do |c| %><th><%= t(".columns.#{c}") %></th><% end %></tr>
    </thead>
    <% @reports.each do |r| %>
      <tr class="border-b border-stone-100 <%= 'bg-red-50' if r.found.zero? %>">
        <td class="px-3 py-1.5"><%= r.language.name %> <span class="text-stone-400"><%= r.language.code %></span></td>
        <td><%= r.found %></td><td><%= r.matched %></td><td><%= r.updates.size %></td><td><%= r.reviews.size %></td>
        <td class="<%= 'text-amber-700' if r.conflicts.any? %>"><%= r.conflicts.size %></td>
        <td class="<%= 'text-amber-700' if r.unmatched.any? %>"><%= r.unmatched.size %></td>
        <td class="text-xs text-stone-500"><%= r.translators.sort_by { |_, n| -n }.first(3).map(&:first).join(", ") %></td>
      </tr>
    <% end %>
  </table>
</div>
<% if @reports.any? { |r| r.found.zero? } %>
  <p class="mb-4 text-sm text-red-700"><%= t(".none_found") %></p>
<% end %>

<% details = @reports.flat_map { |r| r.updates.first(5).map { |u, t, who| [r.language, u, t, who] } } %>
<% if details.any? %>
  <section class="mb-6 rounded border border-stone-200 bg-white p-4 text-sm">
    <h2 class="mb-2 font-semibold"><%= t(".examples") %></h2>
    <% details.first(20).each do |language, unit, text, who| %>
      <p class="mb-1"><span class="font-mono text-xs text-stone-500"><%= language.code %> · <%= unit.key %></span><br>
        <del class="text-stone-400"><%= unit.translations.find { |t| t.language_id == language.id }&.text %></del> → <%= text %> <span class="text-xs text-stone-500">(<%= who %>)</span></p>
    <% end %>
  </section>
<% end %>
<% conflicts = @reports.flat_map { |r| r.conflicts.map { |u, t, who| [r.language, u, t, who] } } %>
<% if conflicts.any? %>
  <section class="mb-6 rounded border border-amber-300 bg-amber-50 p-4 text-sm">
    <h2 class="mb-2 font-semibold"><%= t(".conflicts") %></h2>
    <% conflicts.each do |language, unit, text, who| %>
      <p class="mb-1"><span class="font-mono text-xs"><%= language.code %> · <%= unit.key %></span> — <%= t(".transifex_version", who: who) %> <%= text %></p>
    <% end %>
  </section>
<% end %>
<% unmatched = @reports.flat_map(&:unmatched).uniq %>
<% if unmatched.any? %>
  <details class="mb-6 text-sm"><summary class="cursor-pointer text-stone-600"><%= t(".unmatched", count: unmatched.size) %></summary>
    <% unmatched.first(200).each do |k| %><p class="font-mono text-xs"><%= k %></p><% end %>
  </details>
<% end %>
<%= button_to t(".apply"), migration_apply_path, class: "rounded bg-stone-800 px-4 py-2 text-white",
              form: { data: { turbo_confirm: t(".apply_confirm") } } %>

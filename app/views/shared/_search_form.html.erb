<%# Index (#), branch and text search fields. No submit button : Enter submits, and so does the "×"
    (ours, the native one only exists in WebKit / Blink). `hidden` keeps the other list params. %>
<%= form_with url: url, method: :get, class: "ml-auto flex gap-2 text-stone-900" do %>
  <% hidden.compact_blank.each do |name, value| %>
    <%= hidden_field_tag name, value %>
  <% end %>
  <% { at: "w-40 text-xs tabular-nums", prefix: "w-52 font-mono text-xs", q: "w-64 text-sm" }.each do |name, classes| %>
    <span class="relative flex">
      <%= search_field_tag name, params[name], placeholder: t(".placeholders.#{name}"),
                           onkeydown: "if (event.key === 'Enter') { event.preventDefault(); this.form.requestSubmit() }",
                           class: "peer rounded border border-stone-300 py-1 pr-6 pl-2 [&::-webkit-search-cancel-button]:appearance-none #{classes}" %>
      <button type="button" title="<%= t(".clear") %>" onclick="const i = this.previousElementSibling; i.value = ''; i.form.requestSubmit()"
              class="absolute inset-y-0 right-1 my-auto flex h-5 w-5 items-center justify-center rounded leading-none text-stone-400 peer-placeholder-shown:hidden hover:bg-stone-100 hover:text-stone-700">×</button>
    </span>
  <% end %>
<% end %>

<div class="mb-4 flex items-center gap-4">
  <h1 class="text-lg font-semibold"><%= t(".title") %></h1>
  <% if @mine_filter %>
    <span class="inline-flex shrink-0 rounded border border-stone-300 bg-stone-100 p-0.5 text-xs">
      <% [[t(".all"), translate_root_path, !@mine], [t(".mine"), translate_root_path(mine: 1), @mine]].each do |label, path, current| %>
        <%= link_to label, path, aria: { current: current ? "page" : nil },
                    class: "rounded px-2.5 py-0.5 text-stone-500 hover:text-stone-900 aria-[current=page]:bg-white aria-[current=page]:text-stone-900 aria-[current=page]:shadow-sm" %>
      <% end %>
    </span>
  <% end %>
  <% if current_user.admin? %>
    <%= link_to t(".manage"), manage_languages_path, class: "ml-auto rounded bg-stone-800 px-2.5 py-0.5 text-xs text-white hover:bg-stone-700" %>
  <% end %>
</div>
<% if @editable.empty? %>
  <p class="mb-4 text-stone-600"><%= t(".none") %></p>
<% end %>
<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <% @columns.each do |column, languages| %>
    <section>
      <h2 class="mb-2 flex items-baseline gap-2 text-sm font-semibold text-stone-700">
        <%= t(".columns.#{column}") %>
        <span class="font-normal text-stone-400"><%= languages.size %></span>
      </h2>
      <div class="space-y-3">
        <% languages.each do |language| %>
          <%= render "card", language: language, stats: @stats[language], state: @states[language],
                              editable: @editable.include?(language.id), read_only: @read_only.include?(language.id) %>
        <% end %>
        <% if languages.empty? %>
          <p class="rounded border border-dashed border-stone-300 p-4 text-center text-sm text-stone-400"><%= t(".empty") %></p>
        <% end %>
      </div>
    </section>
  <% end %>
</div>

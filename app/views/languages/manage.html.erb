<% content_for :title, "#{t(".title")} · OpenCutList Localize" %>
<div class="flex max-w-6xl flex-col gap-6 text-sm">
  <h1 class="text-lg font-semibold"><%= t(".title") %></h1>
  <div class="grid items-start gap-6 md:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="flex min-w-0 flex-col gap-6">
      <section class="rounded border border-stone-200 bg-white p-6">
        <h2 class="mb-1 font-semibold"><%= t(".enabled_title") %></h2>
        <p class="mb-3 text-stone-600"><%= t(".enabled_intro_html", file: "src/ladb_opencutlist/ruby/constants.rb") %></p>
        <div class="group/copy relative rounded bg-stone-50 px-3 py-2 pr-10 font-mono text-xs break-all">
          ENABLED_LANGUAGES = <%= @enabled_languages %>
          <%= render "shared/copy_button", text: "ENABLED_LANGUAGES = #{@enabled_languages}", class: "absolute top-1.5 right-1.5" %>
        </div>
      </section>
      <section class="rounded border border-stone-200 bg-white">
        <div class="p-6 pb-3">
          <h2 class="mb-1 font-semibold"><%= t(".existing_title") %></h2>
          <p class="text-stone-600"><%= t(".destroy_hint") %></p>
        </div>
        <table class="w-full">
          <thead class="border-y border-stone-200 bg-stone-50 text-left text-xs text-stone-500">
            <tr>
              <% %w[language translations members].each do |column| %>
                <th class="<%= column == "language" ? "px-6" : "px-3 text-right" %> py-2 font-medium" aria-sort="<%= aria_sort(column, sort: @sort, dir: @dir) %>">
                  <%= sort_header_link(t(".columns.#{column}"), column, sort: @sort, dir: @dir, default_dir: default_dir(column),
                                       url: ->(sort, dir) { manage_languages_path(sort: sort, dir: dir) }) %>
                </th>
              <% end %>
              <th class="px-3 py-2 font-medium" title="<%= t(".compounding_title") %>"><%= t(".columns.compounding") %></th>
              <th class="px-6 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            <% @languages.each do |language| %>
              <% translations = @translations.fetch(language.id, 0) %>
              <% members = @members.fetch(language.id, 0) %>
              <tr>
                <td class="px-6 py-2">
                  <span class="flex items-center gap-2"><span class="w-7 rounded bg-stone-900 text-center font-mono text-xs text-white"><%= language.code.upcase %></span><%= language.name %></span>
                </td>
                <td class="px-3 py-2 text-right tabular-nums"><%= number_with_delimiter(translations) %></td>
                <td class="px-3 py-2 text-right tabular-nums"><%= members %></td>
                <%= render "compounding_button", language: language, sort: @sort, dir: @dir %>
                <td class="px-6 py-2 text-right">
                  <% if language.deletable? %>
                    <%= button_to t(".destroy"), language_path(language), method: :delete, params: { sort: @sort, dir: @dir },
                                  form: { data: { turbo_confirm: t(".destroy_confirm", language: language.name, code: language.code.upcase,
                                                                   translations: number_with_delimiter(translations), members: members) } },
                                  class: "rounded px-2 py-0.5 text-xs text-red-700 hover:bg-red-50" %>
                  <% else %>
                    <span class="text-xs text-stone-400" title="<%= t(".protected_title") %>"><%= t(".protected") %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    </div>
    <section class="order-first rounded border border-stone-200 bg-white p-6 md:order-none">
      <h2 class="mb-1 font-semibold"><%= t(".new_title") %></h2>
      <p class="mb-4 text-stone-600"><%= t(".intro") %></p>
      <%= form_with url: languages_path, scope: nil, class: "flex flex-col gap-3",
                    data: { controller: "language-picker", action: "submit->language-picker#require" } do |f| %>
        <%= render "shared/language_picker", f: f, attribute: :code, label: t(".language"),
                   groups: [[t(".iso_languages"), Language.new_codes.map { |c| [c, Language::ISO[c]["name"], nil] }]],
                   picked: nil, picked_name: nil %>
        <p class="text-xs text-stone-500"><%= t(".hint_html", file: "src/ladb_opencutlist/ruby/constants.rb") %></p>
        <div class="flex justify-end">
          <%= f.submit t(".submit"), class: "rounded bg-stone-800 px-3 py-2 text-white" %>
        </div>
      <% end %>
    </section>
  </div>
</div>

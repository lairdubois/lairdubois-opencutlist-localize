<% field = "mt-1 w-full rounded border border-stone-300 px-3 py-1.5" %>
<% raised = "has-checked:bg-white has-checked:text-stone-900" %>
<% button = "w-full rounded border px-3 py-1.5 text-sm" %>
<%# A new user, or edits refused by a validation (re-rendered as the fields' defaults), can be saved as they are %>
<% clean = @user.persisted? && @user.errors.empty? %>
<%# Actions on the right (below on narrow screens), stuck under the header and the page's toolbar (4rem + 1px).
    dirty-form : save enabled once edited unless above, unsaved-guard asks before leaving. Invite / destroy have
    their own forms, outside (no nesting), joined through their buttons' `form` attribute. Disable / enable likewise %>
<%= form_with model: @user, id: "user_form", class: "group/user flex flex-col items-start gap-4 sm:flex-row", data: { controller: "dirty-form" } do |f| %>
  <div class="w-full max-w-2xl">
    <% if @user.errors.any? %><p class="mb-3 text-sm text-red-700"><%= @user.errors.full_messages.to_sentence %></p><% end %>

    <section class="mb-3 rounded border border-stone-200 bg-white p-4">
      <h2 class="mb-3 font-semibold"><%= t(".profile") %></h2>
      <div class="mb-4 grid gap-3 sm:grid-cols-2">
        <label class="text-sm text-stone-600"><%= User.human_attribute_name(:name) %><%= f.text_field :name, required: true, class: "#{field} text-stone-900" %></label>
        <label class="text-sm text-stone-600"><%= User.human_attribute_name(:email) %><%= f.email_field :email, required: true, class: "#{field} text-stone-900" %></label>
      </div>
      <div class="mb-4 flex items-center justify-between gap-3 text-sm">
        <span class="text-stone-600"><%= User.human_attribute_name(:locale) %></span>
        <%= render "segmented", name: "user[locale]", selected: @user.locale,
                   choices: [[t(".locale_browser"), "", raised], ["Français", "fr", raised], ["English", "en", raised]] %>
      </div>
      <div class="flex items-center justify-between gap-3 text-sm">
        <span class="text-stone-600"><%= t(".admin") %></span>
        <%= render "segmented", name: "user[admin]", selected: @user.admin? ? "1" : "0",
                   choices: [[t(".admin_no"), "0", raised], [t(".admin_yes"), "1", "has-checked:bg-stone-800 has-checked:text-white"]] %>
      </div>
    </section>

    <%# Hidden while admin is checked : every language anyway (the roles are dropped on save) %>
    <section class="mb-3 rounded border border-stone-200 bg-white p-4 group-has-[#user\_admin\_1:checked]/user:hidden">
      <h2 class="mb-2 font-semibold"><%= t(".languages") %></h2>
      <% roles = @user.memberships.to_h { |m| [m.language_id, m.role] } %>
      <% choices = [[t(".no_role"), "", raised],
                    [t("roles.reader").capitalize, "reader", "has-checked:bg-stone-200 has-checked:text-stone-800"],
                    [t("roles.translator").capitalize, "translator", "has-checked:bg-sky-100 has-checked:text-sky-800"],
                    [t("roles.reviewer").capitalize, "reviewer", "has-checked:bg-emerald-100 has-checked:text-emerald-800"]] %>
      <div class="text-sm">
        <% Language.targets.each do |language| %>
          <div class="flex items-center justify-between gap-3 border-b border-stone-100 py-1.5 last:border-0">
            <span class="flex items-center gap-2"><span class="w-7 rounded bg-stone-900 text-center font-mono text-xs text-white"><%= language.code.upcase %></span><%= language.name %></span>
            <%= render "segmented", name: "roles[#{language.id}]", selected: roles[language.id], choices: choices %>
          </div>
        <% end %>
      </div>
    </section>

    <%# The invitations delivered (Invitation), newest first : when, by whom, to which address (the user's may change) %>
    <% if @user.persisted? %>
      <% invitations = @user.invitations.includes(:inviter) %>
      <section class="mb-3 rounded border border-stone-200 bg-white p-4">
        <h2 class="mb-2 flex items-center font-semibold">
          <%= t(".invitations") %>
          <span class="ml-auto text-xs font-normal text-stone-500 tabular-nums"><%= invitations.size %></span>
        </h2>
        <% if invitations.empty? %>
          <p class="text-sm text-stone-400"><%= t(".no_invitation") %></p>
        <% else %>
          <div class="text-sm">
            <% invitations.each do |invitation| %>
              <div class="flex items-center justify-between gap-3 border-b border-stone-100 py-1.5 last:border-0">
                <time datetime="<%= invitation.created_at.iso8601 %>" title="<%= l(invitation.created_at, format: :long) %>"><%= t(".invited_ago", time: time_ago_in_words(invitation.created_at)) %></time>
                <span class="min-w-0 truncate text-stone-500"><%= invitation.inviter&.name || t(".deleted_inviter") %> · <%= invitation.email %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <%# History : pages loaded in lazy frames once unfolded (collapsible's cookie), unfolded by default %>
    <% if @user.persisted? %>
      <% unfolded = section_open?("user_history", default: true) %>
      <section class="rounded border border-stone-200 bg-white" data-controller="collapsible" data-collapsible-name-value="user_history">
        <h2>
          <button type="button" data-collapsible-target="button" data-action="collapsible#toggle" aria-expanded="<%= unfolded %>"
                  class="group/section flex w-full items-center gap-2 px-4 py-2 text-left font-semibold hover:bg-stone-50">
            <%= chevron_icon("text-stone-400 group-aria-expanded/section:rotate-90") %>
            <%= t(".history") %>
            <span class="ml-auto text-xs font-normal text-stone-500 tabular-nums"><%= t(".history_count", count: Revision.by_user(@user).count) %></span>
          </button>
        </h2>
        <div data-collapsible-target="panel" class="border-t border-stone-200" <%= "hidden" unless unfolded %>>
          <%= turbo_frame_tag "user_history_1", src: history_user_path(@user), loading: :lazy do %>
            <p class="p-4 text-sm text-stone-400"><%= t("loading") %></p>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <aside class="w-full shrink-0 rounded border border-stone-200 bg-white p-4 sm:sticky sm:top-[calc(3.5rem+1px+4rem+1px+1rem)] sm:w-56">
    <%= f.button t("save"), type: "submit", disabled: clean, data: { dirty_form_target: ("submit" if clean) },
                 class: "#{button} border-stone-800 bg-stone-800 text-white disabled:cursor-not-allowed disabled:opacity-50" %>
    <% if @user.new_record? %>
      <label class="mt-3 flex items-start gap-2 text-sm"><%= check_box_tag :send_invitation, "1", true, class: "mt-0.5" %> <%= t(".send_invitation") %></label>
    <% end %>
    <%= link_to t("cancel"), users_path, class: "mt-3 block text-center text-sm text-stone-600 hover:text-stone-900" %>
    <% if @user.persisted? %>
      <div class="mt-4 space-y-2 border-t border-stone-200 pt-4">
        <%= button_tag t("users.edit.invite"), type: "submit", form: "invite_user_form", disabled: @user.disabled?,
                       class: "#{button} border-stone-300 bg-white hover:border-stone-400 disabled:cursor-not-allowed disabled:opacity-50" %>
        <% if @user.disabled? %>
          <%= button_tag t("users.edit.enable"), type: "submit", form: "toggle_user_form", class: "#{button} border-stone-300 bg-white hover:border-stone-400" %>
        <% elsif @user != current_user %>
          <%= button_tag t("users.edit.disable"), type: "submit", form: "toggle_user_form", class: "#{button} border-amber-300 bg-white text-amber-800 hover:border-amber-500" %>
        <% end %>
        <%= button_tag t("users.edit.destroy"), type: "submit", form: "destroy_user_form", class: "#{button} border-red-200 bg-white text-red-700 hover:border-red-400" %>
      </div>
    <% end %>
  </aside>
<% end %>
<% if @user.persisted? %>
  <%= form_with url: invite_user_path(@user), id: "invite_user_form", data: { turbo_confirm: t("users.edit.invite_confirm", email: @user.email) } do %><% end %>
  <% if @user.disabled? %>
    <%= form_with url: enable_user_path(@user), method: :patch, id: "toggle_user_form" do %><% end %>
  <% else %>
    <%= form_with url: disable_user_path(@user), method: :patch, id: "toggle_user_form", data: { turbo_confirm: t("users.edit.disable_confirm", name: @user.name) } do %><% end %>
  <% end %>
  <%= form_with url: user_path(@user), method: :delete, id: "destroy_user_form", data: { turbo_confirm: t("users.edit.destroy_confirm", name: @user.name) } do %><% end %>
<% end %>

<% content_for :title, "#{t("layouts.application.users")} · OpenCutList Localize" %>
<%# Toolbar (search, filters, sort, new) stays on screen above the list (.toolbar in application.css) %>
<div class="toolbar">
  <div class="mb-2 flex flex-wrap items-start gap-3">
    <%= render "search_bar", list: @list, languages: @languages %>
    <%# The border matches the search bar's : same height as its first row %>
    <% volunteers = VolunteerRequest.pending.count %>
    <%= link_to volunteers_path, class: "flex items-center gap-1.5 rounded border border-stone-300 bg-white px-3 py-1.5 text-sm text-stone-700 hover:bg-stone-100" do %>
      <%= t(".volunteers") %>
      <% if volunteers.positive? %><span class="rounded-full bg-sky-600 px-1.5 text-xs leading-4 font-medium text-white tabular-nums"><%= volunteers %></span><% end %>
    <% end %>
    <%= link_to t(".new"), new_user_path, class: "rounded border border-stone-800 bg-stone-800 px-3 py-1.5 text-sm text-white" %>
  </div>
</div>
<% if @list.users.empty? %>
  <p class="text-sm text-stone-500">
    <% if @list.filtered? && @list.counts[:searched].positive? %>
      <%= t(".filtered") %>
      <%= link_to t(".show_unfiltered", count: @list.counts[:searched]), users_path(q: params[:q]), class: "text-stone-900 underline" %>
    <% else %>
      <%= t(".empty") %>
    <% end %>
  </p>
<% else %>
  <%# Each header sorts like the search bar's sort menu (its chip follows) %>
  <div class="overflow-x-auto rounded border border-stone-200 bg-white">
    <table class="w-full text-sm">
      <thead class="border-b border-stone-200 bg-stone-50 text-left text-xs text-stone-500">
        <tr>
          <th class="px-3 py-2 font-medium" aria-sort="<%= users_aria_sort(@list, "name") %>"><%= users_sort_link(@list, "name", t(".columns.name")) %></th>
          <th class="px-3 py-2 font-medium" aria-sort="<%= users_aria_sort(@list, "email") %>"><%= users_sort_link(@list, "email", t(".columns.email")) %></th>
          <th class="px-3 py-2 font-medium" aria-sort="<%= users_aria_sort(@list, "languages") %>"><%= users_sort_link(@list, "languages", t(".columns.languages")) %></th>
          <th class="px-3 py-2 font-medium" aria-sort="<%= users_aria_sort(@list, "seen") %>"><%= users_sort_link(@list, "seen", t(".columns.seen")) %></th>
          <th class="px-3 py-2 text-right font-medium" aria-sort="<%= users_aria_sort(@list, "contributions") %>"><%= users_sort_link(@list, "contributions", t(".columns.contributions")) %></th>
          <th class="px-3 py-2 font-medium" aria-sort="<%= users_aria_sort(@list, "activity") %>"><%= users_sort_link(@list, "activity", t(".columns.activity")) %></th>
          <th class="px-3 py-2 font-medium" aria-sort="<%= users_aria_sort(@list, "invited") %>"><%= users_sort_link(@list, "invited", t(".columns.invited")) %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100 tabular-nums">
        <% @list.users.each do |user| %>
          <% stat = @list.stats[user.id] %>
          <%# The whole row opens the user's page (the name's link stretched over the row) ; a disabled user's row is faded %>
          <tr class="relative hover:bg-stone-50 <%= 'opacity-50' if user.disabled? %>">
            <td class="px-3 py-2 whitespace-nowrap">
              <%= link_to user.name, edit_user_path(user), class: "font-medium after:absolute after:inset-0" %>
              <% if user.admin? %><span class="ml-1 rounded bg-stone-800 px-1.5 text-xs text-white">admin</span><% end %>
              <% if user.disabled? %><span class="ml-1 text-xs text-stone-500"><%= t(".disabled") %></span><% end %>
            </td>
            <td class="max-w-64 truncate px-3 py-2 text-stone-500" title="<%= user.email %>"><%= user.email %></td>
            <td class="px-3 py-2">
              <span class="flex flex-wrap gap-1">
                <% user.memberships.sort_by { |m| m.language.code }.each do |m| %>
                  <%# A reader's language : outlined, no fill %>
                  <span class="rounded px-1.5 text-xs <%= m.reviewer? ? 'bg-emerald-100 text-emerald-800' : m.reader? ? 'text-stone-500 ring-1 ring-stone-300 ring-inset' : 'bg-stone-100 text-stone-700' %>"
                        title="<%= t("roles.#{m.role}") %>"><%= m.language.code.upcase %><%= " ✓" if m.reviewer? %></span>
                <% end %>
              </span>
            </td>
            <td class="px-3 py-2 text-xs whitespace-nowrap text-stone-500">
              <% if user.last_seen_at %>
                <time datetime="<%= user.last_seen_at.iso8601 %>" title="<%= l(user.last_seen_at, format: :long) %>"><%= t(".ago", time: time_ago_in_words(user.last_seen_at)) %></time>
              <% else %>
                <span class="text-stone-300"><%= t(".never") %></span>
              <% end %>
            </td>
            <td class="px-3 py-2 text-right <%= 'text-stone-300' unless stat %>"><%= number_with_delimiter(stat&.count || 0) %></td>
            <td class="px-3 py-2 text-xs whitespace-nowrap text-stone-500">
              <% if stat %>
                <time datetime="<%= stat.last_at.iso8601 %>" title="<%= l(stat.last_at, format: :long) %>"><%= t(".ago", time: time_ago_in_words(stat.last_at)) %></time>
              <% else %>
                <span class="text-stone-300">—</span>
              <% end %>
            </td>
            <%# The account's creation on hover, under the last invitation's date %>
            <% created = t(".created_at", date: l(user.created_at, format: :long)) %>
            <td class="px-3 py-2 text-xs whitespace-nowrap text-stone-500">
              <% if (invited_at = @list.invited_at[user.id]) %>
                <time datetime="<%= invited_at.iso8601 %>" title="<%= l(invited_at, format: :long) %>&#10;<%= created %>"><%= t(".ago", time: time_ago_in_words(invited_at)) %></time>
              <% else %>
                <span class="text-stone-300" title="<%= created %>"><%= t(".never") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="mt-2 text-xs text-stone-500"><%= t(".legend") %></p>
<% end %>

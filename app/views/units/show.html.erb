<% content_for :title, @unit.key %>
<%# Previous / next walk the keys list the page was opened from : its filters are recalled as chips %>
<div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
  <div class="flex min-w-0 items-center gap-2">
    <%= link_to "← #{t('layouts.application.keys')}", units_list_url, class: "shrink-0 text-stone-500 hover:text-stone-900" %>
    <% if @list&.query&.any? %>
      <% query = @list.query %>
      <% chip = "flex min-w-0 items-center gap-1 rounded bg-white px-1.5" %>
      <span class="flex min-w-0 flex-wrap items-center gap-1 rounded bg-stone-200 p-0.5 pl-1.5 text-xs text-stone-700" title="<%= t(".list_hint") %>">
        <% if query.statuses.any? %>
          <span class="<%= chip %>">
            <% query.statuses.each_with_index do |key, i| %>
              <% if i > 0 %><span class="text-stone-400"><%= t("shared.search_bar.or") %></span><% end %>
              <%= status_dot(key) %> <%= t("shared.search_bar.statuses.#{key}") %>
            <% end %>
          </span>
        <% end %>
        <% if query.questions? %><span class="<%= chip %>"><%= t("shared.search_bar.questions_chip") %></span><% end %>
        <% if query.warnings? %><span class="<%= chip %>"><%= t("shared.search_bar.warnings_chip") %></span><% end %>
        <% ListFilters::FIELDS.each do |name| %>
          <% next unless query[name] %>
          <span class="<%= chip %>"><span class="text-stone-400"><%= t("shared.search_bar.fields.#{name}") %></span>
            <% if name == "user" %>
              <span class="truncate"><%= query.user&.name || query[name] %></span></span>
            <% else %>
              <span class="truncate <%= name == 'at' ? 'tabular-nums' : 'font-mono' %>"><%= query[name] %></span></span>
            <% end %>
        <% end %>
        <% if query[:q] %><span class="<%= chip %>"><span class="truncate">« <%= query[:q] %> »</span></span><% end %>
        <%= link_to "×", unit_path(@unit, unfiltered: 1), title: t(".unfiltered"), data: { turbo_prefetch: false },
                    class: "flex h-4 w-4 items-center justify-center rounded leading-none text-stone-500 hover:bg-stone-300 hover:text-stone-900" %>
      </span>
    <% end %>
  </div>
  <% if @list %>
    <%# ← / → outside the text fields, Ctrl-Alt-← / → anywhere (key-nav) %>
    <nav class="ml-auto flex min-w-0 items-center gap-1" data-controller="key-nav" data-action="keydown@window->key-nav#navigate">
      <% filtered = @list.query.any? %>
      <span class="mr-1 text-xs whitespace-nowrap text-stone-500 tabular-nums"
            title="<%= t(@position ? (filtered ? ".position_filtered" : ".position_all") : ".not_listed") %>"><%= @position || "–" %> / <%= number_with_delimiter(@list.listed.size) %></span>
      <% { previous: @previous, next: @next }.each do |dir, unit| %>
        <% if unit %>
          <% label = t(".#{dir}", key: unit.key) %>
          <% arrow = dir == :previous ? "←" : "→" %>
          <%= link_to unit_path(unit), title: "#{label} (#{arrow}, Ctrl + Alt + #{arrow})", aria: { label: label },
                      data: { key_nav_target: dir },
                      class: "flex min-w-0 max-w-80 items-center gap-1.5 rounded border border-stone-300 bg-white px-2 py-0.5 text-stone-600 hover:border-stone-400 hover:text-stone-900" do %>
            <% if dir == :previous %><span class="shrink-0">‹</span><% end %>
            <span class="truncate font-mono text-xs" dir="rtl"><bdi><%= unit.key %></bdi></span>
            <% if dir == :next %><span class="shrink-0">›</span><% end %>
          <% end %>
        <% else %>
          <span class="rounded border border-stone-200 px-2 py-0.5 text-stone-300" aria-hidden="true"><%= dir == :previous ? "‹" : "›" %></span>
        <% end %>
      <% end %>
    </nav>
  <% end %>
</div>

<%# dirty-form : unsaved edits flagged (border) and guarded on leave %>
<%= form_with url: rename_unit_path(@unit), method: :patch, class: "group mb-6 flex items-center gap-2", data: { controller: "dirty-form" } do %>
  <% if @index %><span class="text-stone-400 tabular-nums">#<%= @index %></span><% end %>
  <%= text_field_tag :key, @unit.key, class: "flex-1 rounded border border-stone-300 px-3 py-1.5 font-mono group-data-dirty:border-sky-500" %>
  <%= submit_tag t(".rename"), disabled: true, data: { dirty_form_target: "submit" },
                 class: "rounded border border-stone-300 bg-white px-3 py-1.5 disabled:cursor-not-allowed disabled:opacity-50" %>
<% end %>

<section class="mb-8 rounded border border-stone-200 bg-white p-4">
  <div class="mb-2 flex items-center justify-between">
    <h2 class="font-semibold"><%= t(".source") %></h2>
    <button type="button" data-controller="whitespace-toggle" data-action="whitespace-toggle#toggle" title="<%= t("translations.index.show_whitespace") %>"
            class="rounded px-1.5 py-0.5 font-mono text-xs text-stone-500 hover:bg-stone-200 aria-pressed:bg-stone-800 aria-pressed:text-white">¶</button>
  </div>
  <%= form_with url: note_unit_path(@unit), method: :patch, class: "group mb-4", data: { controller: "dirty-form" } do %>
    <label for="note" class="mb-1 block text-sm text-stone-600"># <%= t(".note") %></label>
    <div class="flex items-start gap-2">
      <%= text_area_tag :note, @unit.note, rows: [@unit.note.to_s.lines.size, 1].max,
                        data: { controller: "autosize", action: "input->autosize#resize" },
                        class: "flex-1 resize-none rounded border border-stone-300 bg-stone-50 px-3 py-1.5 font-mono text-sm text-stone-600 group-data-dirty:border-sky-500" %>
      <%= submit_tag t("save"), title: t("unsaved.save_shortcut"), disabled: true, data: { dirty_form_target: "submit" },
                     class: "rounded border border-stone-300 bg-white px-3 py-1.5 text-sm disabled:cursor-not-allowed disabled:opacity-50" %>
    </div>
    <p class="mt-1 text-xs text-stone-400"><%= t(".note_hint") %></p>
  <% end %>
  <%# i18n-text without a source value : highlighted, nothing locked (this is the source) %>
  <%= form_with url: source_unit_path(@unit), method: :patch, class: "group", data: { controller: "i18n-text dirty-form", i18n_text_refs_value: @refs.to_json } do %>
    <%= text_area_tag :source_text, @unit.source_text, rows: [@unit.source_text.lines.size + 1, 2].max, lang: Language::SOURCE_CODE,
                      data: { i18n_text_target: "field" }, class: "min-h-16 w-full rounded border border-stone-300 px-3 py-2 font-mono text-sm group-data-dirty:border-sky-500" %>
    <% TranslationChecks.text(@unit.source_text).each do |w| %><p class="text-xs text-amber-700">⚠ <%= w %></p><% end %>
    <div class="mt-2 flex items-center gap-4 text-sm">
      <%# The kind of change alone isn't an edit %>
      <label><%= radio_button_tag :change, "minor", true, data: { dirty_ignore: true } %> <%= t(".minor") %></label>
      <label><%= radio_button_tag :change, "major", false, data: { dirty_ignore: true } %> <%= t(".major") %></label>
      <span class="ml-auto hidden text-xs text-sky-700 group-data-dirty:inline">● <%= t("unsaved.marker") %></span>
      <%= submit_tag t("save"), title: t("unsaved.save_shortcut"), disabled: true, data: { dirty_form_target: "submit" },
                     class: "rounded bg-stone-800 px-3 py-1.5 text-white group-data-dirty:ml-0 ml-auto disabled:cursor-not-allowed disabled:opacity-50" %>
    </div>
  <% end %>
</section>

<section class="mb-8 rounded border border-stone-200 bg-white">
  <h2 class="border-b border-stone-200 px-4 py-2 font-semibold"><%= t(".translations") %></h2>
  <% @languages.each do |language| %>
    <% t = @translations[language] %>
    <div class="flex gap-4 border-b border-stone-100 px-4 py-2 last:border-0">
      <span class="w-24 shrink-0 text-sm text-stone-500"><%= language.name %></span>
      <% if t %>
        <div class="min-w-0 flex-1">
          <div class="whitespace-pre-wrap font-mono text-sm" dir="<%= language.rtl ? "rtl" : "ltr" %>"
               data-controller="i18n-text" data-i18n-text-text-value="<%= t.text %>" data-i18n-text-source-value="<%= @unit.source_text %>"
               data-i18n-text-refs-value="<%= @refs.to_json %>"><%= t.text %></div>
          <% TranslationChecks.call(@unit.source_text, t.text).each do |w| %><p class="text-xs text-amber-700">⚠ <%= w %></p><% end %>
        </div>
        <% if t.outdated? %><span class="h-fit rounded bg-amber-100 px-1.5 text-xs text-amber-800"><%= t("status.outdated") %></span><% end %>
      <% else %>
        <span class="flex-1 text-sm italic text-stone-400"><%= t("status.untranslated") %></span>
      <% end %>
    </div>
  <% end %>
</section>

<section class="mb-8 rounded border border-stone-200 bg-white p-4">
  <h2 class="mb-2 font-semibold"><%= t(".comments") %></h2>
  <%= render "comments/thread", unit: @unit, language: nil %>
</section>

<section class="mb-8 rounded border border-stone-200 bg-white">
  <h2 class="border-b border-stone-200 px-4 py-2 font-semibold"><%= t(".history") %></h2>
  <% @unit.revisions.includes(:language).reverse_each do |r| %>
    <div class="flex gap-4 border-b border-stone-100 px-4 py-2 text-sm last:border-0">
      <span class="w-36 shrink-0 text-stone-500"><%= l r.created_at, format: :short %></span>
      <span class="w-28 shrink-0"><%= t("revision_kinds.#{r.kind}", default: r.kind) %><%= " (#{r.language.code.upcase})" if r.language %></span>
      <span class="flex-1"><% if r.old_value %><del class="text-stone-400"><%= r.old_value %></del> → <% end %><%= r.new_value %></span>
      <span class="text-stone-500"><%= r.author %></span>
    </div>
  <% end %>
</section>

<%= button_to t(".archive"), archive_unit_path(@unit), method: :patch, class: "text-sm text-red-700 hover:underline",
              form: { data: { turbo_confirm: t(".archive_confirm", key: @unit.key) } } %>

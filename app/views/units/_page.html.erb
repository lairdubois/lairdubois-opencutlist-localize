<%= render partial: "node", collection: @roots, locals: { languages: @languages.size, open: true } %>
<% if @more %>
  <%= turbo_frame_tag "page_#{@page + 1}", src: units_path(request.query_parameters.merge("page" => @page + 1)), loading: :lazy, target: "_top" do %>
    <p class="py-4 text-center text-sm text-stone-400"><%= t("loading") %></p>
  <% end %>
<% end %>

<span class="flex items-center gap-1.5">
  <span class="h-1.5 w-20 overflow-hidden rounded bg-stone-200">
    <span class="block h-full bg-emerald-500" style="width: <%= max.zero? ? 0 : (100.0 * value / max).round %>%"></span>
  </span>
  <% if outdated > 0 %><span class="rounded bg-amber-100 px-1 text-xs text-amber-800"><%= t("status.outdated_count", count: outdated) %></span><% end %>
</span>

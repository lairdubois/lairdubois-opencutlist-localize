<% total_units, translated, outdated = @tree.total %>
<div class="mb-4 flex flex-wrap items-center gap-3">
  <h1 class="text-lg font-semibold"><%= t(".title") %></h1>
  <nav class="flex gap-1 text-sm">
    <% UnitsController::FILTERS.each do |key| %>
      <%= link_to t(".filters.#{key}"), units_path(filter: key, q: params[:q], prefix: params[:prefix], at: params[:at]),
                  title: (t(".filters_hint") unless key == "all"),
                  class: "rounded px-2 py-1 #{key == @filter ? 'bg-stone-800 text-white' : 'text-stone-600 hover:bg-stone-200'}" %>
    <% end %>
  </nav>
</div>

<div class="mb-2 flex flex-wrap items-center gap-3 text-sm text-stone-500">
  <span>
    <%= t("translations.index.count", count: total_units) %> ·
    <%= t("languages.index.translated", percent: number_to_percentage(100.0 * translated / [total_units * @languages.size, 1].max, precision: 0)) %>
    <% if outdated > 0 %>· <span class="text-amber-700"><%= t("status.outdated_count", count: outdated) %></span><% end %>
  </span>
  <%= render "shared/search_form", url: units_path, hidden: { filter: @filter } %>
</div>

<% if total_units.zero? %>
  <p class="text-sm text-stone-500"><%= t("translations.index.empty") %></p>
<% else %>
  <div class="rounded border border-stone-200 bg-white text-sm">
    <% if @open %>
      <%= render "page" %>
    <% else %>
      <%= render partial: "node", collection: @tree.roots, locals: { languages: @languages.size, open: false } %>
    <% end %>
  </div>
<% end %>

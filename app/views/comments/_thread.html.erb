<% comments = language ? unit.comments.visible_in(language).includes(:user, :language) : unit.comments.includes(:user, :language) %>
<%= turbo_frame_tag ["comments", unit.id, language&.code].compact.join("_") do %>
  <div class="flex flex-col gap-2 text-sm">
    <% comments.each do |c| %>
      <div class="rounded <%= c.question && !c.resolved? ? 'bg-sky-50' : 'bg-stone-50' %> px-3 py-2">
        <div class="mb-0.5 flex items-center gap-2 text-xs text-stone-500">
          <span class="font-medium text-stone-700"><%= c.user.name %></span>
          <span><%= l c.created_at, format: :short %></span>
          <span><%= c.language ? c.language.code : t(".all_languages") %></span>
          <% if c.question %>
            <% if c.resolved? %><span class="text-emerald-700"><%= t(".resolved") %></span>
            <% else %>
              <span class="text-sky-800"><%= t(".open") %></span>
              <% if current_user.admin? || c.user == current_user %>
                <%= button_to t(".resolve"), resolve_comment_path(c, lang: language&.code), method: :patch, class: "underline", form: { class: "inline" } %>
              <% end %>
            <% end %>
          <% end %>
        </div>
        <p class="whitespace-pre-wrap"><%= c.body %></p>
      </div>
    <% end %>
    <%= form_with url: unit_comments_path(unit, lang: language&.code), class: "flex flex-col gap-1" do %>
      <%= text_area_tag :body, nil, rows: 2, required: true, placeholder: t(".placeholder"),
                        data: { controller: "autosize", action: "input->autosize#resize" },
                        class: "block w-full resize-none overflow-hidden rounded border border-stone-300 px-2 py-1" %>
      <div class="flex items-center gap-3 text-xs">
        <label><%= check_box_tag :question, "1" %> <%= t(".is_question") %></label>
        <% if language %>
          <label><%= radio_button_tag :scope, "language", true %> <%= language.name %></label>
          <label><%= radio_button_tag :scope, "all" %> <%= t(".all_languages") %></label>
        <% end %>
        <%= submit_tag t(".send"), class: "ml-auto rounded bg-stone-800 px-2 py-1 text-white" %>
      </div>
    <% end %>
  </div>
<% end %>

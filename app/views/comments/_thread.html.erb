<% comments = language ? unit.comments.visible_in(language).includes(:user, :language) : unit.comments.includes(:user, :language) %>
<%= turbo_frame_tag ["comments", unit.id, language&.code].compact.join("_") do %>
  <div class="flex flex-col gap-2 text-sm">
    <% comments.each do |c| %>
      <div class="rounded <%= c.question && !c.resolved? ? 'bg-sky-50' : 'bg-stone-50' %> px-3 py-2">
        <div class="mb-0.5 flex items-center gap-2 text-xs text-stone-500">
          <span class="font-medium text-stone-700"><%= c.user.name %></span>
          <span><%= l c.created_at, format: :short %></span>
          <span><%= c.language ? c.language.code.upcase : t(".all_languages") %></span>
          <% if c.question %>
            <% if c.resolved? %><span class="text-emerald-700"><%= t(".resolved") %></span>
            <% else %>
              <span class="text-sky-800"><%= t(".open") %></span>
              <% if current_user.admin? || c.user == current_user %>
                <%= button_to t(".resolve"), resolve_comment_path(c, lang: language&.code), method: :patch, class: "underline", form: { class: "inline" } %>
              <% end %>
            <% end %>
          <% end %>
        </div>
        <p class="whitespace-pre-wrap"><%= c.body %></p>
      </div>
    <% end %>
    <%= form_with url: unit_comments_path(unit, lang: language&.code), class: "flex flex-col gap-1", data: { controller: "dirty-form" } do %>
      <%= text_area_tag :body, nil, rows: 2, required: true, placeholder: t(language ? ".question_placeholder" : ".placeholder"),
                        data: { controller: "autosize", action: "input->autosize#resize" },
                        class: "block w-full resize-none overflow-hidden rounded border border-stone-300 px-2 py-1" %>
      <div class="flex items-center gap-3 text-xs">
        <%# The translator's comments are questions in their language ; the key page's ones address every language %>
        <% unless language %>
          <label><%= check_box_tag :question, "1", false, data: { dirty_ignore: true } %> <%= t(".is_question") %></label>
        <% end %>
        <%= submit_tag t(".send"), class: "ml-auto rounded bg-stone-800 px-2 py-1 text-white" %>
      </div>
    <% end %>
  </div>
  <%# Keeps the translator's comments button, or the key page's comments header, in step (count, open questions) %>
  <% if language %>
    <%= turbo_stream.replace "comments_button_#{unit.id}_#{language.code}",
                             partial: "translations/comments_button",
                             locals: { unit: unit, language: language, count: comments.size, question: comments.any? { |c| c.question && !c.resolved? } } %>
  <% else %>
    <%= turbo_stream.replace "unit_comments_summary_#{unit.id}", partial: "units/comments_summary",
                             locals: { unit: unit, count: comments.size, questions: comments.count { |c| c.question && !c.resolved? } } %>
  <% end %>
<% end %>

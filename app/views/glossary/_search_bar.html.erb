<%# The glossary's search bar, styled and driven as shared/_search_bar (search_bar_controller) : a text search (the fr
    term, its forms and definition, the shown columns' entries), a "Filters" menu (without a term in a shown column,
    kept as is, archived for the admins), each applied one a removable chip ; a "Columns" menu picking the languages
    shown (by code ; cols[], one inner chip each in the columns' order, dragged to reorder them (column_order_controller), none :
    all of them ; remembered per user). Every change reloads the table
    (GlossaryController#index) %>
<% search = "shared.search_bar" %>
<% group = "flex items-center gap-1 rounded bg-stone-300 p-0.5 pl-2 text-xs text-stone-900" %>
<% sub_chip = "flex items-center gap-1.5 rounded border border-transparent bg-white py-0.5 pr-0.5 pl-2 text-stone-900" %>
<% sub_chip_remove = "flex h-4 w-4 items-center justify-center rounded leading-none text-stone-500 hover:bg-stone-200 hover:text-stone-900" %>
<% item = "flex w-full items-center gap-2 rounded px-3 py-1.5 text-left outline-none hover:bg-stone-100 focus-visible:bg-stone-100" %>
<%# name => [label, on], the ones offered %>
<% filters = { "missing" => [t(".missing_any"), @missing],
               "no_translate" => [t(".no_translate"), @no_translate],
               "archived" => ([t(".archived"), @archived] if current_user.admin?) }.compact %>
<%= form_with url: glossary_path, method: :get, class: "min-w-0 flex-1",
              data: { controller: "search-bar popover", column_order_target: "form", action: "formdata->search-bar#prune keydown@window->search-bar#shortcut keydown.esc@window->search-bar#escape" } do %>
  <%# The columns checked come from here : saved as the user's choice (GlossaryController#set_columns) %>
  <%= hidden_field_tag :cols_set, "1", id: nil %>
  <div class="rounded border border-stone-300 bg-white focus-within:border-stone-400">
    <div class="flex items-center gap-2 pr-1 pl-2.5">
      <span title="<%= t(".shortcuts").strip %>" class="shrink-0 cursor-help">
        <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 text-stone-400" aria-hidden="true">
          <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.45 4.39l3.08 3.08a.75.75 0 1 1-1.06 1.06l-3.08-3.08A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
        </svg>
      </span>
      <%= search_field_tag :q, params[:q], id: nil, placeholder: t(".placeholder"), autocomplete: "off",
                           data: { action: "keydown.enter->search-bar#submit keydown.esc->search-bar#blur" },
                           class: "peer h-8 min-w-0 flex-1 appearance-none bg-transparent py-1.5 text-sm text-stone-900 outline-none [&::-webkit-search-cancel-button]:appearance-none" %>
      <button type="button" title="<%= t("#{search}.clear") %>" data-action="search-bar#clear"
              class="flex h-5 w-5 items-center justify-center rounded leading-none text-stone-400 peer-placeholder-shown:hidden hover:bg-stone-100 hover:text-stone-700">×</button>
      <span id="glossary_count" class="text-xs whitespace-nowrap text-stone-500 tabular-nums"><%= t(".count", count: @counts[:list]) %></span>
      <button type="button" popovertarget="search-filters" data-popover-target="anchor"
              data-action="keydown.down->search-bar#openMenu keydown.up->search-bar#openMenu" class="<%= group %> h-6.5 pr-1.5 hover:bg-stone-400">
        <svg viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5 text-stone-600" aria-hidden="true">
          <path fill-rule="evenodd" d="M2.63 3.4A1 1 0 0 1 3.5 3h13a1 1 0 0 1 .78 1.63L12 11.24V16a1 1 0 0 1-.55.9l-2 1A1 1 0 0 1 8 17v-5.76L2.72 4.63a1 1 0 0 1-.09-1.23Z" clip-rule="evenodd" />
        </svg>
        <%= t("#{search}.filters") %> <span class="text-stone-600">▾</span>
      </button>
      <%# The languages shown, checked one by one among the user's and en : none checked, the user's own ones %>
      <span data-controller="popover" class="contents">
        <button type="button" popovertarget="search-columns" data-popover-target="anchor"
                data-action="keydown.down->search-bar#openMenu keydown.up->search-bar#openMenu" class="<%= group %> -ml-1 h-6.5 pr-1.5 hover:bg-stone-400">
          <svg viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5 text-stone-600" aria-hidden="true">
            <path fill-rule="evenodd" d="M3 4.5A1.5 1.5 0 0 1 4.5 3h11A1.5 1.5 0 0 1 17 4.5v11a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 15.5v-11ZM4.5 4.5v11H7v-11H4.5Zm4 0v11h3v-11h-3Zm4.5 0v11h2.5v-11H13Z" clip-rule="evenodd" />
          </svg>
          <%= t(".columns") %> <span class="text-stone-600">▾</span>
        </button>
        <div id="search-columns" popover data-popover-target="panel"
             data-action="beforetoggle->popover#place toggle->search-bar#focusMenu keydown->search-bar#menuKeydown"
             class="m-0 max-h-96 min-w-64 overflow-y-auto rounded border border-stone-200 bg-white p-1 text-sm text-stone-700 shadow-lg">
          <p class="px-3 pt-1 pb-0.5 text-xs text-stone-500"><%= t(@picked.any? ? ".columns_some" : @columns.size < @all_columns.size ? ".columns_own" : ".columns_all", count: @picked.size) %></p>
          <% @all_columns.sort_by(&:code).each do |language| %>
            <% on = @picked.include?(language.code) %>
            <% stats = @column_stats[language.id] %>
            <button type="button" role="menuitemcheckbox" aria-checked="<%= on %>" data-action="search-bar#toggle"
                    data-search-bar-name-param="cols[]" data-search-bar-value-param="<%= language.code %>" class="<%= item %>">
              <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded border text-[10px] leading-none <%= on ? "border-stone-800 bg-stone-800 text-white" : "border-stone-300" %>"><%= "✓" if on %></span>
              <span class="w-6 shrink-0 text-xs font-bold"><%= language.code.upcase %></span>
              <span class="flex-1" lang="<%= language.code %>"><%= language.name %></span>
              <span class="text-xs text-stone-400 tabular-nums"><%= stats[:filled] %>/<%= stats[:total] %></span>
            </button>
          <% end %>
        </div>
      </span>
    </div>

    <%# Chips : the applied filters, each holding its hidden field (removing it drops the filter) %>
    <% applied = filters.select { |_, (_, on)| on } %>
    <div data-search-bar-target="chips" class="flex flex-wrap gap-1.5 border-t border-stone-200 p-1.5" <%= "hidden" if applied.empty? && @picked.empty? %>>
      <% if @picked.any? %>
        <span class="<%= group %>">
          <%= t(".columns") %>
          <% @columns.each do |language| %>
            <span data-chip <%= column_drag_attributes(language, "chips") if @columns.size > 1 %> class="<%= sub_chip %> <%= "cursor-grab #{GlossaryHelper::DROP_MARK}" if @columns.size > 1 %>">
              <%= language.code.upcase %>
              <%= hidden_field_tag "cols[]", language.code, id: nil %>
              <button type="button" title="<%= t("#{search}.remove") %>" data-action="search-bar#remove" class="<%= sub_chip_remove %>">×</button>
            </span>
          <% end %>
        </span>
      <% end %>
      <% applied.each do |name, (label, _)| %>
        <span data-chip class="<%= group %> pr-0.5">
          <%= label %>
          <%= hidden_field_tag name, "1", id: nil %>
          <button type="button" title="<%= t("#{search}.remove") %>" data-action="search-bar#remove" class="<%= sub_chip_remove %>">×</button>
        </span>
      <% end %>
      <button type="button" title="<%= t(".remove_all") %>" data-action="search-bar#removeAll"
              class="ml-auto flex h-6.5 w-6 items-center justify-center rounded leading-none text-stone-400 hover:bg-stone-100 hover:text-stone-700">×</button>
    </div>
  </div>

  <%# Filters menu : native popover (light dismiss, Esc), placed under its button by popover_controller %>
  <div id="search-filters" popover data-popover-target="panel" data-search-bar-target="menu"
       data-action="beforetoggle->popover#place toggle->search-bar#focusMenu keydown->search-bar#menuKeydown"
       class="m-0 min-w-64 rounded border border-stone-200 bg-white p-1 text-sm text-stone-700 shadow-lg">
    <% filters.each do |name, (label, on)| %>
      <%= render "shared/search_bar_toggle", item: item, name: name, value: 1, on: on, count: @counts[name.to_sym], label: label, dot: nil %>
    <% end %>
  </div>
<% end %>

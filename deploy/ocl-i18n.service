# /etc/systemd/system/ocl-i18n.service
# Puma + Solid Queue (in Puma), listening on 127.0.0.1:3007 behind NGINX
[Unit]
Description=OpenCutList i18n (Rails)
After=network.target

[Service]
Type=simple
User=ocl-i18n
Group=ocl-i18n
WorkingDirectory=/var/www/ocl-i18n/app
EnvironmentFile=/etc/ocl-i18n.env
Environment=PATH=/var/www/ocl-i18n/.rbenv/versions/4.0.1/bin:/usr/local/bin:/usr/bin:/bin
Environment=LD_PRELOAD=libjemalloc.so.2
ExecStart=/var/www/ocl-i18n/.rbenv/versions/4.0.1/bin/ruby bin/rails server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed

# Hardening : the app only writes to its storage, log and tmp directories,
# plus the sandbox's local OCL repo when there is one ("-" : optional path)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/www/ocl-i18n/app/storage /var/www/ocl-i18n/app/log /var/www/ocl-i18n/app/tmp
ReadWritePaths=-/var/www/ocl-i18n/sandbox-repo.git

[Install]
WantedBy=multi-user.target

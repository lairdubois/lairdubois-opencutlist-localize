# /etc/ocl-i18n.env — owner root:ocl-i18n, mode 640
RAILS_ENV=production
# Generated by deploy/setup.sh ; never change it once in use (it encrypts the admins' GitHub tokens)
SECRET_KEY_BASE=
PORT=3007
BINDING=127.0.0.1
SOLID_QUEUE_IN_PUMA=1
RAILS_LOG_LEVEL=info

OCL_HOST=ocl-i18n.lairdubois.fr

# --- Sandbox : publishing goes to a local bare repo on the server, never to GitHub.
# Leave every OCL_GITHUB_* variable empty : no credentials = no pull request on the real repo.
OCL_REPO_URL=file:///var/www/ocl-i18n.lairdubois.fr/sandbox-repo.git

# --- Production : remove OCL_REPO_URL above and fill in the GitHub App
# OCL_GITHUB_APP_ID=
# OCL_GITHUB_APP_PRIVATE_KEY=/var/www/ocl-i18n.lairdubois.fr/github-app.pem
# OCL_GITHUB_APP_CLIENT_ID=
# OCL_GITHUB_APP_CLIENT_SECRET=
# OCL_GITHUB_WEBHOOK_SECRET=

# Claude pre-translation suggestions (optional, billed on the key's account)
ANTHROPIC_API_KEY=

# E-mails : off until explicitly enabled
OCL_MAIL_ENABLED=0
OCL_MAIL_FROM="OpenCutList i18n <noreply@lairdubois.fr>"
SMTP_ADDRESS=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
# Certificate check : skipped for localhost, verified otherwise ; "none" or "peer" forces it
SMTP_OPENSSL_VERIFY_MODE=

# Migration : the Transifex import only reads from Transifex
TRANSIFEX_TOKEN=
TRANSIFEX_RESOURCE=v6
